{
  "name": "matchhire",
  "version": "1.0.0",
  "private": true,
  "description": "MatchHire full-stack workspace - run Backend (Express + MySQL + Redis) and Frontend (Vite + React) together.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently --names \"be,fe\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"npm run dev --prefix Backend\" \"npm run dev --prefix Frontend\"",
    "dev:backend": "npm run dev --prefix Backend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "start": "npm start --prefix Backend",
    "build": "npm run build --prefix Frontend",
    "migrate": "npm run migrate --prefix Backend",
    "seed": "npm run seed --prefix Backend",
    "install:all": "npm install && npm install --prefix Backend && npm install --prefix Frontend",
    "lint": "npm run lint --prefix Backend",
    "qa:seed": "node qa/test-data/seed-test-users.js",
    "qa:start": "PW_AUTO_START=1 playwright test --config qa/playwright.config.js",
    "qa:api": "jest --config qa/jest.config.js",
    "qa:e2e": "playwright test --config qa/playwright.config.js",
    "qa:headed": "playwright test --config qa/playwright.config.js --headed",
    "qa:debug": "PWDEBUG=1 playwright test --config qa/playwright.config.js --headed",
    "qa:matrix": "PW_FULL_MATRIX=1 playwright test --config qa/playwright.config.js",
    "qa:smoke": "playwright test --config qa/playwright.config.js --grep @smoke",
    "qa:accessibility": "playwright test --config qa/playwright.config.js --grep @a11y",
    "qa:lighthouse": "node qa/scripts/lighthouse.js",
    "qa:report": "node qa/scripts/report.js",
    "qa:report:open": "playwright show-report qa/reports/html",
    "qa:full": "node qa/scripts/run-full.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "chrome-launcher": "^1.1.2",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "lighthouse": "^12.2.1",
    "marked": "^18.0.4",
    "mysql2": "^3.11.4",
    "start-server-and-test": "^3.0.5",
    "supertest": "^7.0.0"
  }
}
